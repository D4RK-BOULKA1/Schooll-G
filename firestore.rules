rules_version = '2';

// School-G : règles de sécurité Firestore.
// A coller dans Firebase, Firestore Database, onglet "Règles", puis Publier.
// IMPORTANT : l'email de la fonction isAdmin() doit être le même que adminEmail dans js/config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'boulkassoum11@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Administrateur invité (lecture seule) : son email figure dans la collection admins
    function isViewer() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    function isStaff() { return isAdmin() || isViewer(); }

    // Droits d'un administrateur invité : son propre réglage, sinon le réglage général (admins/_default), sinon autorisé.
    // Clés : dash, schools, prospects, an, pays, logs, view
    function myPerms() { return get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.get('perms', {}); }
    function defPerms() { return exists(/databases/$(database)/documents/admins/_default) ? get(/databases/$(database)/documents/admins/_default).data.get('perms', {}) : {}; }
    function canSchools() {
      let m = myPerms(); let d = defPerms();
      return isAdmin() || (isViewer() && (m.get('schools', d.get('schools', true)) == true || m.get('prospects', d.get('prospects', true)) == true || m.get('dash', d.get('dash', true)) == true || m.get('view', d.get('view', true)) == true));
    }
    function canSubs() {
      let m = myPerms(); let d = defPerms();
      return isAdmin() || (isViewer() && (m.get('pays', d.get('pays', true)) == true || m.get('dash', d.get('dash', true)) == true));
    }
    function canVisits() {
      let m = myPerms(); let d = defPerms();
      return isAdmin() || (isViewer() && (m.get('an', d.get('an', true)) == true || m.get('dash', d.get('dash', true)) == true));
    }
    function can(k) {
      let m = myPerms(); let d = defPerms();
      return isAdmin() || (isViewer() && m.get(k, d.get(k, true)) == true);
    }

    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function now() { return request.time.toMillis(); }

    function trialDays() {
      return exists(/databases/$(database)/documents/global/config)
        ? get(/databases/$(database)/documents/global/config).data.get('trialDays', 7)
        : 7;
    }

    // L'école a-t-elle un accès actif (essai valide ou abonnement payé, ni bloquée ni bannie) ?
    function hasAccess(uid) {
      let s = get(/databases/$(database)/documents/schools/$(uid)).data;
      return s.banned == false && s.blocked == false
        && ((s.paidUntilMs != null && s.paidUntilMs > now())
            || (s.trialCancelled == false && s.trialEndMs > now()));
    }

    // Configuration globale : tarifs, durée d'essai, contacts, annonce
    match /global/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fiche école et abonnement
    match /schools/{uid} {
      allow get: if isOwner(uid) || canSchools();
      allow list: if canSchools();

      // Création à l'inscription : essai gratuit uniquement, pas d'abonnement ni de statut truqué
      allow create: if isOwner(uid)
        && request.resource.data.ownerUid == uid
        && request.resource.data.plan == 'Essai gratuit'
        && request.resource.data.paidUntilMs == null
        && request.resource.data.banned == false
        && request.resource.data.blocked == false
        && request.resource.data.trialCancelled == false
        && request.resource.data.trialEndMs <= now() + (trialDays() + 1) * 86400000;

      // Le directeur ne modifie que ses infos et ses statistiques, jamais l'abonnement
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'director', 'phone', 'city', 'ownerEmail', 'stats', 'updatedAtMs']));

      allow delete: if isAdmin();

      // Données de l'école (élèves, paiements, notes...) : seulement si l'accès est actif
      match /d/{docId} {
        allow read: if isOwner(uid) || can('view');
        allow write: if isAdmin() || (isOwner(uid) && hasAccess(uid));
      }
    }

    // Informations publiques d'une école pour l'espace parent (identifiée par son code)
    match /pub/{code} {
      allow get: if true;
      allow list: if canSchools();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.access.paidUntilMs == null
        && request.resource.data.access.banned == false
        && request.resource.data.access.blocked == false
        && request.resource.data.access.trialCancelled == false
        && request.resource.data.access.trialEndMs <= now() + (trialDays() + 1) * 86400000;

      // Le directeur ne peut pas toucher au champ "access" (réservé à l'administrateur)
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerUid)
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.access == resource.data.access);

      allow delete: if isAdmin();
    }

    // Dossier d'un élève pour son parent : lecture par identifiant secret uniquement (pas de liste)
    match /pstu/{id} {
      allow get: if true;
      allow list: if can('view');
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || isOwner(resource.data.ownerUid);
    }

    // Dossier d'un enseignant pour lui-même : lecture par identifiant secret uniquement (pas de liste)
    match /ptea/{id} {
      allow get: if true;
      allow list: if can('view');
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || isOwner(resource.data.ownerUid);
    }

    // Demandes d'avance sur salaire : un enseignant (identifié par son dossier secret ptea) crée une demande ;
    // la direction la lit et la décide ; la demande se lit par son identifiant aléatoire.
    match /adv/{id} {
      allow get: if true;
      allow list: if can('view') || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if request.resource.data.keys().hasOnly(['ownerUid', 'key', 'tid', 'tname', 'amount', 'note', 'month', 'status', 'createdMs'])
        && request.resource.data.status == 'en attente'
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 10000000
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && exists(/databases/$(database)/documents/ptea/$(request.resource.data.key))
        && get(/databases/$(database)/documents/ptea/$(request.resource.data.key)).data.ownerUid == request.resource.data.ownerUid;
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedMs']));
      allow delete: if isAdmin() || isOwner(resource.data.ownerUid);
    }

    // Messages de l'administrateur : lisibles par l'école visée (ou par toutes), écriture réservée à l'admin
    match /msgs/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.target in ['all', request.auth.uid]);
      allow write: if isAdmin();
    }

    // Parrainage : un filleul déclare son parrain à l'inscription ; le parrain lit ses filleuls ; l'admin accorde la récompense
    match /refs/{id} {
      allow read: if can('prospects') || can('schools')
        || (signedIn() && exists(/databases/$(database)/documents/schools/$(request.auth.uid))
            && resource.data.code == get(/databases/$(database)/documents/schools/$(request.auth.uid)).data.code);
      allow create: if signedIn() && id == request.auth.uid && request.resource.data.ownerUid == request.auth.uid && request.resource.data.rewarded == false;
      allow update, delete: if isAdmin();
    }

    // Abonnements payés et journal : administrateur uniquement
    match /subs/{id} { allow read: if canSubs(); allow write: if isAdmin(); }
    match /logs/{id} { allow read: if can('logs'); allow write: if isAdmin(); }

    // Compteur de visites de la page d'accueil : n'importe qui peut ajouter 1 (jamais plus), seul le personnel lit
    match /vstats/{day} {
      allow read: if canVisits();
      allow create: if request.resource.data.keys().hasOnly(['day', 'n', 'u'])
        && request.resource.data.n == 1 && request.resource.data.u in [0, 1] && request.resource.data.day == day;
      allow update: if request.resource.data.keys().hasOnly(['day', 'n', 'u'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.u in [resource.data.u, resource.data.u + 1];
      allow delete: if isAdmin();
    }

    // Données analytiques anonymes (une session = un document au nom aléatoire) : n'importe qui peut créer sa session et la faire
    // progresser (temps actif et pages vues, par petits pas), seul le personnel lit, seul l'administrateur supprime.
    match /sess/{id} {
      function str(v, n) { return v is string && v.size() <= n; }
      allow read: if can('an');
      allow create: if request.resource.data.keys().hasOnly(['day', 'startMs', 'endMs', 'hr', 'dur', 'pages', 'entry', 'last', 'vid', 'ret', 'src', 'dev', 'os', 'br', 'model', 'sw', 'lang', 'tz', 'net', 'pwa', 'dark', 's_i', 's_l', 's_a', 's_p', 's_t'])
        && request.resource.data.keys().hasAll(['day', 'startMs', 'dur', 'pages', 'entry'])
        && str(request.resource.data.day, 10) && request.resource.data.dur == 0 && request.resource.data.pages == 1
        && str(request.resource.data.entry, 24) && str(request.resource.data.last, 24) && str(request.resource.data.vid, 20) && str(request.resource.data.src, 40)
        && str(request.resource.data.dev, 12) && str(request.resource.data.os, 20) && str(request.resource.data.br, 24) && str(request.resource.data.model, 28)
        && str(request.resource.data.sw, 12) && str(request.resource.data.lang, 10) && str(request.resource.data.tz, 40) && str(request.resource.data.net, 6);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dur', 'pages', 'last', 'endMs', 's_i', 's_l', 's_a', 's_p', 's_t'])
        && request.resource.data.dur >= resource.data.dur && request.resource.data.dur - resource.data.dur <= 60 && request.resource.data.dur <= 43200
        && request.resource.data.pages >= resource.data.pages && request.resource.data.pages - resource.data.pages <= 1 && request.resource.data.pages <= 300
        && str(request.resource.data.last, 24);
      allow delete: if isAdmin();
    }

    // Administrateurs invités (lecture seule) : seul l'administrateur principal les gère ; chacun peut lire sa propre fiche
    match /admins/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email.lower() == email) || (email == '_default' && isViewer());
      allow write: if isAdmin();
    }
  }
}

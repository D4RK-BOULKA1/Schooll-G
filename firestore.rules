rules_version = '2';

// School-G : règles de sécurité Firestore.
// A coller dans Firebase, Firestore Database, onglet "Règles", puis Publier.
// IMPORTANT : l'email de la fonction isAdmin() doit être le même que adminEmail dans js/config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'boulkassoum11@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Administrateur invité (lecture seule) : son email figure dans la collection admins
    function isViewer() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    function isStaff() { return isAdmin() || isViewer(); }

    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function now() { return request.time.toMillis(); }

    function trialDays() {
      return exists(/databases/$(database)/documents/global/config)
        ? get(/databases/$(database)/documents/global/config).data.get('trialDays', 7)
        : 7;
    }

    // L'école a-t-elle un accès actif (essai valide ou abonnement payé, ni bloquée ni bannie) ?
    function hasAccess(uid) {
      let s = get(/databases/$(database)/documents/schools/$(uid)).data;
      return s.banned == false && s.blocked == false
        && ((s.paidUntilMs != null && s.paidUntilMs > now())
            || (s.trialCancelled == false && s.trialEndMs > now()));
    }

    // Configuration globale : tarifs, durée d'essai, contacts, annonce
    match /global/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fiche école et abonnement
    match /schools/{uid} {
      allow get: if isOwner(uid) || isStaff();
      allow list: if isStaff();

      // Création à l'inscription : essai gratuit uniquement, pas d'abonnement ni de statut truqué
      allow create: if isOwner(uid)
        && request.resource.data.ownerUid == uid
        && request.resource.data.plan == 'Essai gratuit'
        && request.resource.data.paidUntilMs == null
        && request.resource.data.banned == false
        && request.resource.data.blocked == false
        && request.resource.data.trialCancelled == false
        && request.resource.data.trialEndMs <= now() + (trialDays() + 1) * 86400000;

      // Le directeur ne modifie que ses infos et ses statistiques, jamais l'abonnement
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'director', 'phone', 'city', 'ownerEmail', 'stats', 'updatedAtMs']));

      allow delete: if isAdmin();

      // Données de l'école (élèves, paiements, notes...) : seulement si l'accès est actif
      match /d/{docId} {
        allow read: if isOwner(uid) || isStaff();
        allow write: if isAdmin() || (isOwner(uid) && hasAccess(uid));
      }
    }

    // Informations publiques d'une école pour l'espace parent (identifiée par son code)
    match /pub/{code} {
      allow get: if true;
      allow list: if isStaff();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.access.paidUntilMs == null
        && request.resource.data.access.banned == false
        && request.resource.data.access.blocked == false
        && request.resource.data.access.trialCancelled == false
        && request.resource.data.access.trialEndMs <= now() + (trialDays() + 1) * 86400000;

      // Le directeur ne peut pas toucher au champ "access" (réservé à l'administrateur)
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerUid)
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.access == resource.data.access);

      allow delete: if isAdmin();
    }

    // Dossier d'un élève pour son parent : lecture par identifiant secret uniquement (pas de liste)
    match /pstu/{id} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || isOwner(resource.data.ownerUid);
    }

    // Messages de l'administrateur : lisibles par l'école visée (ou par toutes), écriture réservée à l'admin
    match /msgs/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.target in ['all', request.auth.uid]);
      allow write: if isAdmin();
    }

    // Parrainage : un filleul déclare son parrain à l'inscription ; le parrain lit ses filleuls ; l'admin accorde la récompense
    match /refs/{id} {
      allow read: if isStaff()
        || (signedIn() && exists(/databases/$(database)/documents/schools/$(request.auth.uid))
            && resource.data.code == get(/databases/$(database)/documents/schools/$(request.auth.uid)).data.code);
      allow create: if signedIn() && id == request.auth.uid && request.resource.data.ownerUid == request.auth.uid && request.resource.data.rewarded == false;
      allow update, delete: if isAdmin();
    }

    // Abonnements payés et journal : administrateur uniquement
    match /subs/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /logs/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    // Compteur de visites de la page d'accueil : n'importe qui peut ajouter 1 (jamais plus), seul le personnel lit
    match /vstats/{day} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['day', 'n', 'u'])
        && request.resource.data.n == 1 && request.resource.data.u in [0, 1] && request.resource.data.day == day;
      allow update: if request.resource.data.keys().hasOnly(['day', 'n', 'u'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.u in [resource.data.u, resource.data.u + 1];
      allow delete: if isAdmin();
    }

    // Administrateurs invités (lecture seule) : seul l'administrateur principal les gère ; chacun peut lire sa propre fiche
    match /admins/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }
  }
}
